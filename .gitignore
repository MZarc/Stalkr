# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Rust build cache (tens of GB, regenerable via cargo / tauri build).
# Covers target/, target-test/, target_check/, etc.
src-tauri/target*/

# Android / Gradle outputs & caches (regenerable via tauri android build).
src-tauri/gen/android/build/
src-tauri/gen/android/.gradle/
src-tauri/gen/android/app/build/
src-tauri/gen/android/app/.cxx/
src-tauri/gen/android/.kotlin/
# Machine-specific SDK/NDK paths; recreated from ANDROID_HOME or Tauri CLI.
src-tauri/gen/android/local.properties

# Release binaries — kept locally in release/, not bloating git.
*.apk
*.aab
release/
